  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@storybook/react-vite": "^10.4.6",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.6",
    "vite": "^8.1.0"
  }
